{
    "name": "@designliquido/delegua-lsp",
    "version": "0.0.0",
    "description": "Language Server Protocol para linguagem Delégua e dialetos de Portugol.",
    "main": "./dist/index.js",
    "bin": {
        "delegua-lsp": "./dist/servidor.js"
    },
    "scripts": {
        "copiar-arquivos-pacote": "yarn copyfiles -V ./package.json ./dist && yarn copyfiles -V ./README.md ./dist",
        "empacotar": "yarn rimraf ./dist && yarn tsc && yarn copiar-arquivos-pacote",
        "servidor": "node ./dist/servidor.js",
        "testes-unitarios": "jest --coverage"
    },
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/DesignLiquido/delegua-lsp/issues"
    },
    "homepage": "https://github.com/DesignLiquido/delegua-lsp#readme",
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "dependencies": {
        "@designliquido/birl": "^0.6.7",
        "@designliquido/delegua": "^1.23.4",
        "@designliquido/mapler": "^0.7.7",
        "@designliquido/portugol-studio": "^0.11.7",
        "@designliquido/potigol": "^0.11.7",
        "@designliquido/visualg": "^0.9.7",
        "vscode-languageserver": "^9.0.1",
        "vscode-languageserver-textdocument": "^1.0.12"
    },
    "devDependencies": {
        "@types/jest": "^29.5.14",
        "@types/node": "^22.0.0",
        "copyfiles": "^2.4.1",
        "jest": "^29.7.0",
        "release-it": "^20.0.1",
        "rimraf": "^6.1.3",
        "ts-jest": "^29.3.4",
        "ts-node": "^10.9.2",
        "typescript": "^5.0.0"
    }
}
