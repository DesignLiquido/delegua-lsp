{
    "name": "@designliquido/delegua-lsp",
    "version": "0.0.3",
    "description": "Language Server Protocol para linguagem Delégua e dialetos de Portugol.",
    "main": "./dist/index.js",
    "bin": {
        "delegua-lsp": "./dist/servidor.js"
    },
    "scripts": {
        "copiar-arquivos-pacote": "yarn copyfiles -V ./package.json ./dist && yarn copyfiles -V ./README.md ./dist && node -e \"const fs=require('fs');const p=JSON.parse(fs.readFileSync('./dist/package.json','utf8'));p.main='./index.js';p.bin={'delegua-lsp':'./servidor.js'};delete p.files;fs.writeFileSync('./dist/package.json',JSON.stringify(p,null,4))\"",
        "empacotar": "yarn rimraf ./dist && yarn tsc && yarn copiar-arquivos-pacote",
        "servidor": "node ./dist/servidor.js",
        "testes-unitarios": "jest --coverage"
    },
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/DesignLiquido/delegua-lsp/issues"
    },
    "homepage": "https://github.com/DesignLiquido/delegua-lsp#readme",
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "dependencies": {
        "vscode-languageserver": "^9.0.1",
        "vscode-languageserver-textdocument": "^1.0.12"
    },
    "peerDependencies": {
        "@designliquido/birl": "^0.6.12",
        "@designliquido/delegua": "^1.24.4",
        "@designliquido/mapler": "^0.7.12",
        "@designliquido/portugol-studio": "^0.11.12",
        "@designliquido/potigol": "^0.11.12",
        "@designliquido/visualg": "^0.9.12"
    },
    "devDependencies": {
        "@designliquido/birl": "^0.6.12",
        "@designliquido/delegua": "^1.26.1",
        "@designliquido/mapler": "^0.7.12",
        "@designliquido/portugol-studio": "^0.11.12",
        "@designliquido/potigol": "^0.11.12",
        "@designliquido/visualg": "^0.9.12",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.0.0",
        "copyfiles": "^2.4.1",
        "jest": "^29.7.0",
        "release-it": "^20.0.1",
        "rimraf": "^6.1.3",
        "ts-jest": "^29.3.4",
        "ts-node": "^10.9.2",
        "typescript": "^5.0.0"
    }
}
